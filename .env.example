# Copiez ce fichier en .env et remplissez les valeurs.

# Adresse publique du site (sert pour les liens envoyés sur WhatsApp)
BASE_URL=https://lakoifff.com
PORT=3000

# Mot de passe de l'espace administrateur (/admin.html), 10 caractères minimum
ADMIN_PASSWORD=

# Fichier de la base de données (sur Render/Railway : un dossier sur disque persistant)
DB_FILE=./data/lakoiff.db

# Coiffeurs d'exemple au premier démarrage (mettre 0 pour ne pas les créer)
SEED_DEMO=1
# Numéro WhatsApp qui reçoit les demandes des coiffeurs d'exemple (tests)
DEMO_WHATSAPP=+243859204238

# Numéro WhatsApp de La.Koiff (contact du site, reçoit les candidatures des coiffeurs)
CONTACT_WHATSAPP=+243859204238

# Vérification du numéro par code WhatsApp à l'inscription : automatique quand WhatsApp est branché.
# Mettre 1 pour tester sans WhatsApp (les codes s'affichent dans la console), 0 pour désactiver.
# VERIFY_PHONE=

# Connexion avec Google : identifiant client OAuth (Google Cloud Console). Vide = bouton Google désactivé.
GOOGLE_CLIENT_ID=

# Connexion avec Facebook : identifiant et clé secrète de l'application (developers.facebook.com). Vides = bouton Facebook désactivé.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- API WhatsApp Cloud (Meta) ----
# Laissez vide pour tester sans WhatsApp : les messages s'affichent dans la console.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Code secret de l'application Meta (vérifie que les webhooks viennent bien de Meta)
WHATSAPP_APP_SECRET=
# Mot de passe que vous choisissez et que vous recopiez dans Meta pour le webhook
WHATSAPP_VERIFY_TOKEN=choisissez-un-mot-de-passe
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=fr
